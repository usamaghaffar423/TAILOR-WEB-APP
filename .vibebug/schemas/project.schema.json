  "type": "object",
  "required": [
    "schemaVersion",
    "projectId",
    "name",
    "repository"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "projectId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "repository": {
      "type": "object"
    }
  }
}
